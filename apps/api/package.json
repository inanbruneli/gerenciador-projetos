    "multer": "^2.5.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "prisma": "~7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
