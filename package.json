{
  "name": "gerenciador-projetos",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "trap \"kill 0\" INT TERM EXIT; npm run dev:api & npm run dev:web",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build --workspaces"
  }
}
